{
    "name": "fastbuyjson-mcp-server-reference",
    "version": "1.0.0",
    "description": "Reference MCP server for the FastBuyJSON standard. Talks to a FastBuyJSON HTTP API; mock entry point is src/index-mock.ts.",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "start:mock": "node dist/index-mock.js",
        "dev": "tsc --watch",
        "test": "node test.js",
        "inspector": "node --inspect dist/index.js"
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "fastbuyjson",
        "e-commerce",
        "reference",
        "ai",
        "llm"
    ],
    "author": "FastBuyJSON Team",
    "license": "MIT",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.25.1",
        "axios": "^1.12.2",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.5.0"
    },
    "engines": {
        "node": ">=18"
    },
    "note": "Reference implementation. Multi-tenant billing and analytics live in fast-buy-json-saas."
}