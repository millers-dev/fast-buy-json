{
  "suite": "validation",
  "scenarios": [
    {
      "name": "login missing password returns VALIDATION_ERROR",
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/auth/login",
            "body": { "username": "demo" }
          },
          "expect": {
            "status": 400,
            "code": "VALIDATION_ERROR"
          }
        }
      ]
    },
    {
      "name": "cart add missing productId returns VALIDATION_ERROR",
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/cart/add",
            "body": { "quantity": 1 }
          },
          "expect": {
            "status": 400,
            "code": "VALIDATION_ERROR"
          }
        }
      ]
    },
    {
      "name": "checkout initiate invalid email returns VALIDATION_ERROR",
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/cart/add",
            "body": { "productId": "acme-wh-001", "quantity": 1 }
          },
          "expect": { "status": 200 },
          "capture": { "cartId": "cart.id" }
        },
        {
          "request": {
            "method": "POST",
            "path": "/checkout/initiate",
            "body": {
              "cartId": "{{cartId}}",
              "customerInfo": {
                "email": "not-an-email",
                "phone": "+1-555-0123"
              },
              "shippingAddress": {
                "line1": "123 Main St",
                "city": "Berlin",
                "country": "DE",
                "postalCode": "10115"
              }
            }
          },
          "expect": {
            "status": 400,
            "code": "VALIDATION_ERROR"
          }
        }
      ]
    },
    {
      "name": "patch cart item with zero quantity returns VALIDATION_ERROR",
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/cart/add",
            "body": { "productId": "acme-wh-001", "quantity": 1 }
          },
          "expect": { "status": 200 },
          "capture": { "itemId": "cart.items.0.itemId" }
        },
        {
          "request": {
            "method": "PATCH",
            "path": "/cart/items/{{itemId}}",
            "body": { "quantity": 0 }
          },
          "expect": {
            "status": 400,
            "code": "VALIDATION_ERROR"
          }
        }
      ]
    }
  ]
}
