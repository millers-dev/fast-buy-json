        {
            "name": "Checkout",
            "item": [
                {
                    "name": "Initiate Checkout",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.sessionToken) {",
                                    "    pm.environment.set(\"sessionToken\", jsonData.sessionToken);",
                                    "    console.log('Session token set:', jsonData.sessionToken);",
                                    "}",
                                    "if (jsonData.verificationToken) {",
                                    "    pm.environment.set(\"verificationToken\", jsonData.verificationToken);",
                                    "}",
                                    "",
                                    "// Also store expiresAt if available",
                                    "if (jsonData.expiresAt) {",
                                    "    pm.environment.set(\"sessionExpiresAt\", jsonData.expiresAt);",
                                    "    console.log('Session expiration set:', jsonData.expiresAt);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{accessToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"cartId\": \"{{cartId}}\",\n  \"customerInfo\": {\n    \"email\": \"customer@example.com\",\n    \"phone\": \"+49123456789\"\n  },\n  \"shippingAddress\": {\n    \"line1\": \"123 Main St\",\n    \"city\": \"Berlin\",\n    \"region\": \"Berlin\",\n    \"country\": \"DE\",\n    \"postalCode\": \"10115\"\n  },\n  \"billingAddress\": {\n    \"line1\": \"123 Main St\",\n    \"city\": \"Berlin\",\n    \"region\": \"Berlin\",\n    \"country\": \"DE\",\n    \"postalCode\": \"10115\"\n  }\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/checkout/initiate",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "checkout",
                                "initiate"
                            ]
                        },
                        "description": "Start the checkout process"
                    },
                    "response": []
                },
                {
                    "name": "Confirm Checkout",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "// Store order ID from different possible response formats",
                                    "if (jsonData.orderId) {",
                                    "    // Direct orderId property in response",
                                    "    pm.environment.set(\"orderId\", jsonData.orderId);",
                                    "    console.log('Order ID set from direct property:', jsonData.orderId);",
                                    "}",
                                    "else if (jsonData.order && jsonData.order.id) {",
                                    "    // Order ID from order object",
                                    "    pm.environment.set(\"orderId\", jsonData.order.id);",
                                    "    console.log('Order ID set from order object:', jsonData.order.id);",
                                    "}",
                                    "",
                                    "// Store order status URL if available",
                                    "if (jsonData.orderStatusUrl) {",
                                    "    pm.environment.set(\"orderStatusUrl\", jsonData.orderStatusUrl);",
                                    "    console.log('Order status URL set:', jsonData.orderStatusUrl);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{accessToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"sessionToken\": \"{{sessionToken}}\",\n  \"paymentDetails\": {\n    \"method\": \"credit_card\",\n    \"cardDetails\": {\n      \"lastFourDigits\": \"4242\",\n      \"brand\": \"Visa\"\n    },\n    \"transactionVerification\": {\n      \"verificationMethod\": \"email_confirmation\",\n      \"verificationToken\": \"{{verificationToken}}\"\n    }\n  }\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/checkout/confirm",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "checkout",
                                "confirm"
                            ]
                        },
                        "description": "Complete the checkout process"
                    },
                    "response": []
                }
            ]
