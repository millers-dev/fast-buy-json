{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Product Search Request",
    "description": "Parameters for searching the product catalog",
    "type": "object",
    "properties": {
        "query": {
            "type": "string",
            "description": "Search query text",
            "examples": [
                "wireless headphones"
            ]
        },
        "filters": {
            "type": "object",
            "description": "Filters to apply to the search",
            "additionalProperties": true,
            "examples": [
                {
                    "brand": "Acme",
                    "priceRange": {
                        "min": 50,
                        "max": 200
                    }
                }
            ]
        },
        "sort": {
            "type": "string",
            "description": "Sorting method",
            "enum": [
                "price_asc",
                "price_desc",
                "relevance",
                "newest"
            ],
            "default": "relevance",
            "examples": [
                "price_asc"
            ]
        },
        "page": {
            "type": "integer",
            "description": "Page number (1-based)",
            "minimum": 1,
            "default": 1,
            "examples": [
                1
            ]
        },
        "pageSize": {
            "type": "integer",
            "description": "Number of items per page",
            "minimum": 1,
            "maximum": 100,
            "default": 10,
            "examples": [
                10
            ]
        },
        "extensions": {
            "type": "object",
            "description": "Additional custom fields",
            "additionalProperties": true
        }
    }
}